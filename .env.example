# Token del Bot Discord (ottenuto da https://discord.com/developers/applications)
DISCORD_TOKEN=il_tuo_token_del_bot_qui

# Application ID (Client ID) del bot (si trova nella pagina General Information del Discord Developer Portal)
CLIENT_ID=il_tuo_client_id_qui

# ID del canale testuale dove il bot invierà i messaggi di Server Aperto / Server Chiuso
CHANNEL_ID=id_del_tuo_canale_discord_qui

# (Opzionale) ID del server Discord: se specificato, i comandi slash si attivano istantaneamente senza dover attendere la cache globale
GUILD_ID=

# Intervallo in secondi tra un controllo e l'altro (default: 30)
CHECK_INTERVAL=30

# Configurazione Host Angy
ANGY_HOST=cobblemunzs.duckdns.org
ANGY_PORT=25565

# Configurazione Host Rick
RICK_HOST=cobbleverse-pazza.duckdns.org
RICK_PORT=25565

# Porta per l'health check HTTP su Railway (Railway imposta questa variabile in automatico)
PORT=3000
